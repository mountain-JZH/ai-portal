[Unit]
Description=AI Portal FastAPI service
After=network.target

[Service]
Type=simple
User=aiportal
Group=aiportal
WorkingDirectory=/opt/ai-portal/backend
EnvironmentFile=/opt/ai-portal/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ai-portal/backend/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
